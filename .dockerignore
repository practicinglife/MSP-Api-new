# Never bake secrets, editor state or history into the image. Settings come from .env at runtime
# (docker compose env_file), not from the build context.
.env
.env.*
!.env.example
.git
.github
.vs
.vscode
.idea
.claude
.devcontainer
.pytest_cache
.ruff_cache
.mypy_cache
**/__pycache__
**/*.pyc
node_modules
reports
tests
docs
deploy
*.db
*.sqlite
*.log
