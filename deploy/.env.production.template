# ─── MSP API Tools — Production .env template ───
# Copy to .env on the server (deploy/server-setup.sh does this for you)
# and fill in real values. NEVER commit the populated file.

# ── ConnectWise PSA ──
CWM_BASE_URL=https://api-na.myconnectwise.net
CWM_COMPANY_ID=your_company_id
CWM_PUBLIC_KEY=
CWM_PRIVATE_KEY=
CWM_CLIENT_ID=

# ── SentinelOne ──
S1_BASE_URL=https://your-tenant.sentinelone.net
S1_API_TOKEN=

# ── ESET Protect Cloud ──
ESET_BASE_URL=https://eu.business-account.iam.eset.systems
ESET_USERNAME=
ESET_PASSWORD=
ESET_TENANT_ID=

# ── Asio / N-able RMM ──
ASIO_BASE_URL=https://api.ncentral.com
ASIO_API_TOKEN=

# ── ScreenConnect ──
SC_BASE_URL=https://your-instance.screenconnect.com
SC_USERNAME=
SC_PASSWORD=

# ── Database (defaults match docker-compose) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/msp_tools

# ── Optional public exposure ──
# Set NGROK_AUTHTOKEN to enable the ngrok tunnel service. Leave blank to skip.
# On a real Linux server with a public IP you usually do NOT need ngrok —
# expose port 8000 directly via the firewall or a reverse proxy.
NGROK_AUTHTOKEN=

# ── App settings ──
LOG_LEVEL=INFO
RECONCILE_INTERVAL_MINUTES=60
