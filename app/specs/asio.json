            }
          }
        }
      },
      "post": {
        "summary": "Create a scheduled automation task",
        "description": "Create a new scheduled automation task. Requires platform.automation.create scope.",
        "tags": ["Automation"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "201": { "description": "Automation task created" }
        }
      }
    },
    "/api/platform/v1/device/groups": {
      "get": {
        "summary": "List device groups",
