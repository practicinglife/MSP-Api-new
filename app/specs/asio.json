    "/api/platform/v1/policies/{id}": {
      "put": {
        "summary": "Update a policy",
        "description": "Update an existing partner policy. Requires platform.policies.update scope.",
        "tags": ["Policies"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Policy updated" }
        }
      },
      "delete": {
        "summary": "Delete a policy",
        "description": "Delete a partner policy. Requires platform.policies.delete scope.",
        "tags": ["Policies"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
