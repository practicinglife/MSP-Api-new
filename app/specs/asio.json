        "tags": ["Devices"],
        "responses": {
          "200": {
            "description": "List of device groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/v1/custom-fields/definitions": {
      "get": {
        "summary": "List custom field definitions",
