# Copy this file to .env and fill it in. NEVER commit the real .env.
# Most settings can stay blank. The /setup page lists what still needs attention.

# ════════════════════════════ Core ════════════════════════════

# ── Database ── PostgreSQL. Pick a strong password for a new install (docker compose uses POSTGRES_PASSWORD).
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/msp_tools

# ── Security ──
# Encrypts stored credentials; first-run setup needs it too. Generate with: python -m app.cli gen-master-key
# Keep a copy somewhere safe: losing it means re-entering every stored credential.
MSP_MASTER_KEY=
# What may write to connected APIs: read_only (default) | direct | approval.
# Override per connection on the Connections page, or with MSP_WRITE_MODE_<NAME>=...
MSP_WRITE_MODE_DEFAULT=read_only
# Connections may call any internet or on-prem address except link-local / cloud metadata.
# Set to 1 to also refuse private and loopback networks (internet-only installs).
MSP_BLOCK_PRIVATE_TARGETS=0
# Requests per minute per signed-in caller / per IP on sign-in endpoints
MSP_RATE_LIMIT_PER_MIN=600
MSP_RATE_LIMIT_ANON_PER_MIN=60

# ── Sign-in ── Every page and API needs a signed-in person, connection key or OAuth token.
# No identity provider? The first-run /setup page creates an admin (password + authenticator app), or:
#   python -m app.cli create-user admin --role admin
# Microsoft Entra ID / Office 365:
MSP_ENTRA_TENANT_ID=
MSP_ENTRA_CLIENT_ID=
MSP_ENTRA_CLIENT_SECRET=
# …or any other OpenID Connect provider (Google, Okta, Keycloak, Auth0) instead of the Entra lines:
MSP_OIDC_ISSUER=
MSP_OIDC_CLIENT_ID=
MSP_OIDC_CLIENT_SECRET=
# Claim holding roles/groups, and an optional map from its values to app roles
# (MSPTools.User | MSPTools.Editor | MSPTools.Approver | MSPTools.Admin)
MSP_OIDC_ROLES_CLAIM=roles
MSP_OIDC_ROLE_MAP=
MSP_OIDC_DISPLAY_NAME=

# ── Your organization and network ──
MSP_ORG_NAME=Your MSP
# Public hostname of your HTTPS edge (deploy/edge); leave blank for LAN-only use
MSP_EDGE_DOMAIN=
MSP_EXTERNAL_BASE_URL=
# URL people's AI clients use for the MCP servers, if it differs from the above (e.g. https://tools.lan:8443)
MSP_PUBLIC_BASE_URL=
# Office public IPs treated as internal when they arrive through the edge (comma separated)
MSP_OFFICE_IPS=

# ── Local copies of connection data ── scheduled syncs (on|off) and the most records one sync may keep
MSP_CONNECTION_SYNC=on
MSP_SYNC_MAX_RECORDS=200000

# ════════════════════════════ Packs ════════════════════════════
# Optional feature packs, comma separated. A new install starts with none.
#   msp — ConnectWise PSA, Asio, ScreenConnect, SentinelOne and ESET synced into this database: client
#         registry, reconciliation, AV gaps, discrepancies, helpdesk, onboarding, the MSP dashboard, /msp/mcp
MSP_PACKS=

# ── MSP pack: vendor credentials (only those you use; blank = that vendor is off) ──
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=
CW_BASE_URL=https://na.myconnectwise.net/v4_6_release/apis/3.0
ASIO_CLIENT_ID=
ASIO_CLIENT_SECRET=
ASIO_REGION=NA
SCREENCONNECT_BASE_URL=
SCREENCONNECT_AUTH_TOKEN=
S1_BASE_URL=
S1_API_TOKEN=
ESET_USERNAME=
ESET_PASSWORD=
ESET_BASE_URL=https://mspapi.eset.com
# ESET PROTECT cloud (per-device details)
ESET_CONNECT_USERNAME=
ESET_CONNECT_PASSWORD=
AVAST_CLIENT_ID=
AVAST_CLIENT_SECRET=

# ── MSP pack: ConnectWise PSA business rules (leave blank to turn the dependent feature off) ──
# Agreement type that marks a company as a managed client
MSP_PSA_MANAGED_AGREEMENT_TYPE=
# Optional extra agreement types that also count (AV billing, standalone SentinelOne)
MSP_PSA_AV_BILLING_AGREEMENT_TYPE=
MSP_PSA_S1_AGREEMENT_TYPE=
# Configuration types that count as managed devices (comma separated; default: Managed Workstation(s), Managed Server(s))
#MSP_PSA_DEVICE_TYPES=Managed Workstation,Managed Server
# New-client onboarding: agreement type id, template agreement id, name label, catalog product prefix
MSP_PSA_AGREEMENT_TYPE_ID=
MSP_AGREEMENT_TEMPLATE_ID=
MSP_PSA_AGREEMENT_LABEL=Managed Services
MSP_PSA_PRODUCT_PREFIX=
# PSA company that collects unassigned alert tickets (helpdesk triage)
MSP_CATCHALL_COMPANY_ID=
# Time zone for new Asio companies (Windows display name), e.g. (UTC-06:00) Central Time (US & Canada)
MSP_DEFAULT_TIMEZONE=(UTC) Coordinated Universal Time
# Asio automation script that reinstalls ScreenConnect in the right company
MSP_SC_REPAIR_SCRIPT=
# Mailbox new SentinelOne sites / ESET companies send alerts to
MSP_ALERT_EMAIL=
# Optional JSON file of company-name aliases for matching, e.g. {"acme": "acme plumbing and heating"}
MSP_COMPANY_ALIASES_FILE=
